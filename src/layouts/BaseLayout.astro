---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, withBase } from '../data/site';

const {
  title,
  description = SITE.description,
  ogType = 'website',
  image = SITE.ogImage,
  jsonLd = [],
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const homeUrl = new URL(withBase(''), Astro.site).href;
const logoUrl = new URL(withBase('logo.jpg'), Astro.site).href;
const ogImage = new URL(withBase(image), Astro.site).href;
const robots = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1';

// Базовые данные об организации/сайте — отдаём поисковикам и AI-движкам на каждой странице.
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.botName,
  url: homeUrl,
  logo: logoUrl,
  description: SITE.description,
  sameAs: [SITE.botUrl],
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.botName,
  url: homeUrl,
  inLanguage: 'ru-RU',
};
const allLd = [orgLd, websiteLd, ...jsonLd];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/jpeg" href={withBase('favicon.jpg')} />
    <link rel="stylesheet" href={withBase('styles.css')} />
    <meta name="theme-color" content="#FBBF24" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={SITE.botName} />
    <meta property="og:site_name" content={SITE.botName} />
    <meta property="og:locale" content={SITE.locale} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {allLd.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    <script is:inline src={withBase('anim.js')} defer></script>
  </body>
</html>
