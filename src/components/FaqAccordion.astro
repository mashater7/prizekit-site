---
const { items } = Astro.props; // [{ q, a }]
---
<section>
  <div class="container">
    <h2 style="text-align:center;margin-bottom:28px;">Частые вопросы</h2>
    <div class="faq">
      {items.map((it) => (
        <details>
          <summary>{it.q}</summary>
          <div class="ans" set:html={it.a}></div>
        </details>
      ))}
    </div>
  </div>
</section>
