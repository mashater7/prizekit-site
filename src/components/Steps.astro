---
const { heading, steps } = Astro.props;
---
<section>
  <div class="container">
    <h2 style="text-align:center;margin-bottom:28px;">{heading}</h2>
    <div class="grid grid-4">
      {steps.map((s, i) => (
        <div class="card">
          <div class="step-num">{i + 1}</div>
          <h3>{s.title}</h3>
          <p class="muted">{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
