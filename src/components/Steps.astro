---
const { heading, steps } = Astro.props;
---
<section class="steps-sec">
  <div class="container">
    <h2 class="sec-h2">{heading}</h2>
    <div class="steps">
      {steps.map((s, i) => (
        <div class="step">
          <div class="step-num">{i + 1}</div>
          <div class="step-body">
            <h3>{s.title}</h3>
            <p class="muted">{s.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
