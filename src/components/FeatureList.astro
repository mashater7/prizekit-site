---
const items = [
  { e: '🛡️', t: 'Защита Антибот от накруток' },
  { e: '🎁', t: 'Мультипризовые розыгрыши — несколько призов по датам' },
  { e: '🔒', t: 'Работает с приватными каналами и чатами' },
  { e: '🖼️', t: 'Фото и видео в посте розыгрыша' },
  { e: '👥', t: 'Мультиканальные розыгрыши со спонсорами' },
  { e: '🔢', t: 'Живой счётчик участников прямо в посте' },
  { e: '⏱️', t: 'Завершение по дате или по числу участников' },
  { e: '🔁', t: 'Переразыгрыш и замена победителя в один клик' },
  { e: '📊', t: 'Аналитика: новые подписчики, отписки, экспорт в Excel' },
  { e: '🏆', t: 'Любое число победителей' },
];
---
<section class="band">
  <div class="container">
    <h2 class="sec-h2">Возможности</h2>
    <ul class="feats">
      {items.map((it) => (
        <li><span class="feat-emoji">{it.e}</span>{it.t}</li>
      ))}
    </ul>
  </div>
</section>
