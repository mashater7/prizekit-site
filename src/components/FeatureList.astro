---
const items = [
  { e: '🛡️', t: 'Защита Антибот от накруток' },
  { e: '🎟️', t: 'Реферальная система — билеты за друзей' },
  { e: '🔒', t: 'Работает с приватными каналами' },
  { e: '🖼️', t: 'Фото и видео в посте розыгрыша' },
  { e: '👥', t: 'Мультиканальные розыгрыши со спонсорами' },
  { e: '🔁', t: 'Переразыгрыш приза в один клик' },
  { e: '📊', t: 'Статистика подписок и участников' },
  { e: '🏆', t: 'Любое число победителей' },
];
---
<section class="band">
  <div class="container">
    <h2 class="sec-h2">Возможности</h2>
    <ul class="feats">
      {items.map((it) => (
        <li><span class="feat-emoji">{it.e}</span>{it.t}</li>
      ))}
    </ul>
  </div>
</section>
