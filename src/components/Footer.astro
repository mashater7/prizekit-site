---
import { SITE, withBase } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container cols">
    <div>
      <div class="ft-brand">{SITE.botName}</div>
      <p class="muted">{SITE.tagline}</p>
    </div>
    <nav>
      <a href={withBase('how-it-works')}>Как это работает</a>
      <a href={withBase('randomizer')}>Рандомайзер</a>
      <a href={withBase('pricing')}>Тарифы</a>
      <a href={withBase('faq')}>FAQ</a>
      <a href={withBase('blog')}>Блог</a>
    </nav>
    <nav>
      <a href={withBase('offer')}>Договор оферты</a>
      <a href={withBase('terms')}>Пользовательское соглашение</a>
      <a href={withBase('privacy')}>Конфиденциальность</a>
    </nav>
    {/* TODO: блок «Другие наши боты — скоро» при добавлении продуктов */}
  </div>
  <div class="container copyright muted">© {year} {SITE.botName}</div>
</footer>
