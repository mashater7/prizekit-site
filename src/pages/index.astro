---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeatureCards from '../components/FeatureCards.astro';
import Steps from '../components/Steps.astro';
import FeatureList from '../components/FeatureList.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { SITE } from '../data/site';

const connectSteps = [
  { icon: '✍️', title: 'Напишите боту', text: 'Откройте Приз_КитБот в MAX и нажмите Старт.' },
  { icon: '🛡️', title: 'Добавьте в админы', text: 'Добавьте бота в подписчики, затем в администраторы канала.' },
  { icon: '🎁', title: 'Создайте розыгрыш', text: 'Заполните форму: текст, приз, сроки — и запустите.' },
];
const howSteps = [
  { icon: '📝', title: 'Создаёте розыгрыш', text: 'В удобной форме: текст, фото, число победителей, сроки.' },
  { icon: '📢', title: 'Пост публикуется', text: 'Бот сам публикует пост с кнопкой «Участвовать» в каналах.' },
  { icon: '👥', title: 'Люди участвуют', text: 'Бот проверяет подписку и считает участников.' },
  { icon: '🏆', title: 'Бот выбирает', text: 'Случайно и честно определяет победителей и оповещает их.' },
];
const faq = [
  { q: 'Можно ли в MAX проводить розыгрыши бесплатно?', a: 'Да, Приз_КитБот бесплатный. Подключите бота к каналу и создайте розыгрыш.' },
  { q: 'Как бот выбирает победителя?', a: 'Случайным образом из участников, выполнивших все условия. Доступен переразыгрыш.' },
  { q: 'Сколько каналов и победителей может быть?', a: 'Неограниченное число каналов-спонсоров и победителей.' },
  { q: 'Что такое реферальная ссылка?', a: 'Персональная ссылка-приглашение: за приведённых друзей участник получает дополнительные билеты.' },
  { q: 'Можно ли разыграть несколько призов в одном посте?', a: 'Да. Приз_КитБот поддерживает мультипризовые розыгрыши: несколько призов на разные даты в одном розыгрыше с промежуточными итогами.' },
];

// Структурированные данные: бесплатное приложение + блок вопросов-ответов (для поисковиков и AI-ответов).
const appLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.botName,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'MAX',
  description: SITE.description,
  url: SITE.botUrl,
  inLanguage: 'ru-RU',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'RUB' },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title="Розыгрыши и конкурсы в MAX — бесплатный бот | Приз_КитБот"
  description="Приз_КитБот — бесплатный бот для честных розыгрышей и конкурсов в MAX: проверка подписки, антибот, реферальная система, мультипризовые розыгрыши, любое число победителей."
  jsonLd={[appLd, faqLd]}
>
  <Hero />
  <FeatureCards />
  <Steps heading="Как подключить за 3 шага" steps={connectSteps} />
  <Steps heading="Как это работает" steps={howSteps} />
  <FeatureList />
  <FaqAccordion items={faq} />
  <CtaBanner />
</BaseLayout>
