---
// Гайд Антибот_КитБота — та самая «полная инфа», на которую бот ссылается
// из приветствия и из сводки проверки.
//
// Почему страница, а не глава в самом боте. В переписке длинный текст не
// читают: он занимает десять экранов телефона и теряется среди кнопок.
// Сюда же владелец канала может вернуться в любой момент и переслать ссылку
// рекламодателю, который спросит «а откуда у вас эти цифры».
//
// Всё, что здесь написано, должно совпадать с тем, как бот работает на самом
// деле. Источники: src/lib/help.js, signals.js, groups.js, categorize.js.
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../data/site';

const BOT_URL = 'https://max.ru/id772975617249_1_bot';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: new URL(withBase(''), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Как Антибот_КитБот анализирует каналы', item: new URL(withBase('antibot-guide'), Astro.site).href },
  ],
};

// Строки отчёта. Порядок — как в самом боте.
const rows = [
  {
    icon: '🤖', name: 'Боты',
    what: 'Сам MAX пометил аккаунт как бота.',
    who: 'Не человек.',
    remove: 'Да. Это единственный случай, когда мне хватает одного признака: спорить с платформой не о чем.',
  },
  {
    icon: '🗑', name: 'Удалённые аккаунты',
    what: 'Человек стёр себя из MAX, а в списке подписчиков остался.',
    who: 'Никого. Этого аккаунта уже не существует.',
    remove: 'Да. Самое безопасное, что вообще можно удалять.',
  },
  {
    icon: '🚜', name: 'Похоже на накрутку',
    what: 'Вижу следы закупки: пачка аккаунтов вошла в одну минуту, профили одинаково пустые, имена повторяются.',
    who: 'Скорее всего, купленные подписчики.',
    remove: 'Да, но только если признаков не меньше двух.',
  },
  {
    icon: '📢', name: 'Реклама в описании профиля',
    what: 'Человек сам написал у себя в профиле «казино», «ставки», «накрутка подписчиков».',
    who: 'Чаще всего рассыльщик, пришедший за вашей аудиторией.',
    remove: 'Да, при втором признаке.',
  },
  {
    icon: '🕳', name: 'Вступили, не заходя в мессенджер',
    what: 'По данным MAX человек последний раз был в мессенджере раньше, чем вступил в ваш канал.',
    who: 'Живой человек так не может. Обычно это подписка через чужую сессию.',
    remove: 'Да, при втором признаке.',
  },
  {
    icon: '💀', name: 'Мёртвые аккаунты',
    what: 'Давно не заходили в MAX вообще. Срок задаёте вы сами.',
    who: '⚠️ Живые люди. Просто давно не открывали мессенджер.',
    remove: 'Только по вашему решению. Само по себе «давно не заходил» уликой не считается.',
  },
  {
    icon: '😴', name: 'Подписались и не открывают канал',
    what: 'В MAX человек заходит, а конкретно в ваш канал не заглядывает.',
    who: '⚠️ Живые люди. Уехал, заболел, стало неинтересно — причин масса.',
    remove: 'Только по вашему решению.',
  },
  {
    icon: '❓', name: 'Подозрительные имена',
    what: 'Имя выглядит сгенерированным: случайный набор букв и цифр.',
    who: 'Может быть и накрутка, и человек с необычным ником.',
    remove: 'Само по себе — нет. Это мягкий признак.',
  },
  {
    icon: '✅', name: 'Без замечаний',
    what: 'Ни одного повода для подозрений.',
    who: 'Ваша живая аудитория.',
    remove: 'Никогда.',
  },
  {
    icon: '🛡', name: 'Защищены',
    what: 'Администраторы канала и все, кого вы внесли в белый список.',
    who: 'Свои.',
    remove: 'Никогда, что бы я ни нашёл.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Почему бот пишет «чистить некого», хотя в списке есть подозрительные?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Бот удаляет человека только когда признаков не меньше двух и хотя бы один из них надёжный. Одного «давно не заходил» недостаточно — за ним обычно живой подписчик.',
      },
    },
    {
      '@type': 'Question',
      name: 'Что означает «мёртвые аккаунты» в отчёте?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Это живые люди, которые давно не открывали мессенджер MAX. Срок задаёт владелец канала. Бот их показывает, но сам не удаляет.',
      },
    },
    {
      '@type': 'Question',
      name: 'Что бот называет «странным» в суточном отчёте?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Две вещи: когда люди уходят строем — пачка отписалась разом, и все они вступали в один день; и когда человек вошёл в канал и вышел в первые полчаса.',
      },
    },
  ],
};
---

<BaseLayout
  title="Как Антибот_КитБот анализирует каналы MAX и что значат его отчёты"
  description="Полное описание: откуда бот берёт данные о подписчиках MAX, что означает каждая строка отчёта, по каким правилам он считает накрутку и почему живых людей не удаляет."
  jsonLd={[breadcrumbLd, faqLd]}
>
  <section>
    <div class="container guide">
      <h1>Как я анализирую каналы и что написано в моих отчётах</h1>

      <p class="lead">
        Это полное описание работы <b>Антибот_КитБота</b> — бота, который показывает
        владельцу канала в MAX, из кого состоит его аудитория. Здесь написано, откуда
        берутся цифры, что означает каждая строка отчёта и почему бот отказывается
        удалять людей, на которых у него не хватает улик.
      </p>

      <nav class="toc" aria-label="Содержание">
        <a href="#data">Откуда я беру данные</a>
        <a href="#rows">Что значат строки отчёта</a>
        <a href="#two">Почему «чистить некого»</a>
        <a href="#groups">Что видно только по списку целиком</a>
        <a href="#strange">Что я называю «странным»</a>
        <a href="#raid">Наплыв людей: когда я предупреждаю</a>
        <a href="#terms">Сроки: кого считать уснувшим</a>
        <a href="#stats">Статистика канала</a>
        <a href="#never">Чего я не делаю никогда</a>
      </nav>

      <h2 id="data">Откуда я беру данные</h2>
      <p>
        У меня нет тайных источников. Всё, что я знаю, мне отдаёт сам мессенджер MAX,
        когда вы делаете меня администратором канала.
      </p>
      <ul>
        <li><b>Список подписчиков</b> — с датой, когда каждый вступил, и датой, когда он последний раз был в мессенджере.</li>
        <li><b>Отметка «это бот»</b> — её ставит сама платформа.</li>
        <li><b>Профиль</b> — имя, фото, описание. Ровно то, что видит любой человек, открывший карточку.</li>
        <li><b>Приходы и уходы</b> — я записываю их в свой журнал с той минуты, как вы меня подключили.</li>
        <li><b>Просмотры постов</b> — из самих постов канала.</li>
      </ul>
      <p class="note">
        <b>Важно про историю.</b> Что было в канале до моего подключения, MAX мне не покажет —
        такого запроса просто не существует. Поэтому приходы и уходы я считаю с того дня,
        как меня добавили в канал. Первые сутки отчёт будет короткий, и это нормально.
      </p>
      <p class="note">
        <b>Ещё честность про даты.</b> Дату последнего захода MAX отдаёт не по всем: человек мог
        закрыть её в настройках приватности. Если даты нет — я не выдумываю её и не считаю
        это уликой. Молчание в мою пользу не работает.
      </p>

      <h2 id="rows">Что значат строки отчёта</h2>
      <p>
        Главное правило: <b>каждый человек попадает ровно в одну строку</b> — в самую заметную
        для него. Строки — это корзины, а не оценки. Если человек оказался в строке
        «не открывают канал», это не значит, что он плохой: это значит, что более серьёзных
        замечаний к нему у меня нет.
      </p>

      <div class="cards">
        {rows.map(r => (
          <article class="card">
            <h3><span class="ic">{r.icon}</span> {r.name}</h3>
            <p><b>Что это.</b> {r.what}</p>
            <p><b>Кто это.</b> {r.who}</p>
            <p><b>Удаляю ли.</b> {r.remove}</p>
          </article>
        ))}
      </div>

      <p class="note">
        Строку с нулём я всё равно показываю, если речь о ботах, накрутке или удалённых
        аккаунтах: <b>«Боты — 0»</b> — это тоже ответ, а не пустая строка.
      </p>

      <h2 id="two">Почему бывает «чистить некого»</h2>
      <p>
        Это самый частый вопрос: в отчёте сотни подозрительных, а кнопки «Почистить» нет.
        Так и задумано.
      </p>
      <p>
        <b>Я удаляю человека, только если признаков не меньше двух и хотя бы один из них
        надёжный.</b> Единственное исключение — отметка платформы «это бот»: её ставит сам MAX.
      </p>
      <div class="two">
        <div>
          <h3>Надёжные признаки</h3>
          <p>Так живой человек выглядеть не может:</p>
          <ul>
            <li>платформа сама пометила аккаунт ботом;</li>
            <li>последний раз был в мессенджере <i>раньше</i>, чем вступил в канал;</li>
            <li>прямая реклама казино, ставок или интим-услуг в описании профиля;</li>
            <li>вошёл в общем залпе, и его имя повторяется у других аккаунтов из того же залпа.</li>
          </ul>
        </div>
        <div>
          <h3>Мягкие признаки</h3>
          <p>Встречаются и у обычных людей:</p>
          <ul>
            <li>давно не заходил в мессенджер;</li>
            <li>давно не открывал канал;</li>
            <li>необычное имя;</li>
            <li>нет фото профиля.</li>
          </ul>
        </div>
      </div>
      <p>
        Поэтому «давно не заходил» + «нет фото» я под нож не отправлю: это портрет половины
        обычных людей старшего возраста. <b>Лучше пропустить накрутчика, чем выкинуть вашего
        подписчика</b> — потерянного живого человека не вернёшь, а накрутчик просто останется
        цифрой в отчёте.
      </p>
      <p class="note">
        Что бы я ни нашёл, удаление запускаете вы: своей кнопкой и своим подтверждением.
        Перед этим можно выгрузить весь список файлом и посмотреть глазами — напротив каждого
        имени написана причина. Если удалили и передумали — есть кнопка «Вернуть удалённых».
      </p>

      <h2 id="groups">Что видно только по списку целиком</h2>
      <p>
        Накрученный подписчик поодиночке выглядит ровно как живая бабушка без фото: он просто
        ничего не делает — это и есть его портрет. Ферму видно только скопом, поэтому я смотрю
        на список целиком.
      </p>
      <ul>
        <li>
          <b>Залп.</b> Десять и более человек вступили в одном десятиминутном окне,
          и хотя бы у семи из десяти профиль пустой. Живой всплеск после удачного поста
          так не выглядит: у людей разные профили.
        </li>
        <li>
          <b>Повтор имён.</b> Одно и то же имя и фамилия у разных аккаунтов. Само по себе —
          мягкий признак: однофамильцы существуют. Но если такие аккаунты ещё и вошли
          одним залпом — это уже надёжная улика.
        </li>
      </ul>

      <h2 id="strange">Что я называю «странным»</h2>
      <p>
        В суточном отчёте я пишу «не было ли странного». Странное — это ровно две вещи,
        никакой мистики.
      </p>
      <ul>
        <li>
          <b>Люди ушли строем.</b> Живые отписываются вразнобой, каждый в свой день.
          А купленная аудитория уходит разом: сервисы накрутки продают подписчиков
          с гарантией на 30, 60 или 90 дней и по истечении срока снимают их пачкой.
          Если такое случилось, я скажу и покажу, в какой день эти люди вступали —
          вам останется вспомнить, не было ли тогда рекламной закупки.
        </li>
        <li>
          <b>Вошёл и сразу вышел.</b> Человек подписался и отписался в первые полчаса.
          Так бывает и с живыми (не понравился контент), и с накруткой, которую тут же списали.
          Поэтому я просто показываю число, а выводы за вами.
        </li>
      </ul>
      <p>
        Если за сутки ничего такого не было, я пишу «ничего странного не заметил» —
        и это хорошая новость, а не отписка.
      </p>

      <h2 id="raid">Наплыв людей: когда я предупреждаю</h2>
      <p>
        Если в канал за короткое время заходит толпа, я пишу об этом владельцу в личку.
        Порог по умолчанию — <b>50 человек за десять минут</b>.
      </p>
      <p>
        Что показываю в таком сообщении: сколько человек пришло, сколько из них без фото
        профиля и у скольких в описании профиля реклама. Это три цифры, по которым сразу
        видно разницу между удачным постом и закупкой.
      </p>
      <p class="note">
        Толпа сама по себе не улика. Люди приходят и после удачного поста, и после рекламы,
        и после репоста в большом канале — это нормально и хорошо. Поэтому я <b>никого не
        удаляю</b> и не предлагаю удалить: сигнал нужен, чтобы вы посмотрели своими глазами.
      </p>
      <p>
        Выключить или включить сигналы можно в меню канала: <b>«⚙️ Ещё» → «📣 Наплыв людей»</b>.
        Там же лежат сроки из следующего раздела и ссылка на сам канал — всё, что настраивают
        один раз и дальше не трогают.
      </p>
      <p>
        Закрыть канал для новых подписчиков я не могу: боту в MAX разрешено менять только
        название, описание, аватар и закреплённое сообщение. Кнопка, которая ничего не делает,
        была бы хуже её отсутствия, поэтому вместо неё в боте — короткая инструкция и разбор
        тех, кто уже успел войти.
      </p>

      <h2 id="terms">Сроки: кого считать уснувшим</h2>
      <p>
        Два срока вы задаёте сами, и они влияют <b>только на то, что я покажу</b>:
      </p>
      <ul>
        <li><b>«Не заходил в MAX»</b> — сколько человек не открывал мессенджер вообще.</li>
        <li><b>«Не открывал этот канал»</b> — заходит в MAX, но сюда не заглядывает.</li>
      </ul>
      <p>
        Чем больше срок, тем осторожнее я себя веду и тем меньше людей попадает в списки.
        Изменение срока никого не удаляет — оно меняет только картину на экране.
      </p>
      <p>
        Где менять: меню канала → <b>«⚙️ Ещё» → «⏳ Кого считать уснувшим»</b>.
      </p>

      <h2 id="stats">Статистика канала и картинка для рекламодателя</h2>
      <p>
        Кроме чистки я показываю обычные показатели канала. Кнопка «📊 Статистика канала»
        сразу присылает их картинкой, а те же цифры пишу подписью под ней — такое сообщение
        удобно переслать рекламодателю одним движением.
      </p>
      <ul>
        <li><b>Подписчиков</b> — сколько сейчас, и прирост за сутки, неделю и месяц.</li>
        <li><b>Просмотров на пост</b> — среднее за последние 24, 48 и 72 часа, и какой это процент от подписчиков.</li>
        <li><b>Как рос канал</b> — график по дням и таблица прироста.</li>
      </ul>
      <p class="note">
        Если за сутки в канале не было постов, я ставлю прочерк, а не ноль. Ноль означал бы
        «канал не читают» — это была бы неправда.
      </p>
      <p>
        Прирост я считаю по своим ежедневным замерам, поэтому первые дни после подключения
        цифры за неделю и месяц будут пустыми: я столько ещё не наблюдаю.
      </p>

      <h2 id="never">Чего я не делаю никогда</h2>
      <p>Вы отдаёте мне права администратора, поэтому честно скажу, где границы.</p>
      <ul>
        <li><b>Не удаляю никого по своей воле.</b> Ни одна моя функция не удаляет людей сама.</li>
        <li><b>Не сужу по национальности.</b> Имя на арабском, иврите или японском — это национальность, а не улика. Многие боты чистят по алфавиту имени; я так не делаю принципиально.</li>
        <li><b>Не наказываю за пустой профиль.</b> Нет фото — это половина обычных людей в MAX.</li>
        <li><b>Не считаю активность подозрительной.</b> Накрутка как раз ничего не делает — она тихая.</li>
        <li><b>Не наказываю за настройки приватности.</b> Скрыли «был в сети» — я просто не знаю даты и не трогаю вас.</li>
        <li><b>Не хожу в чужие каналы.</b> Каждая кнопка проверяет, ваш ли это канал.</li>
      </ul>
      <p>
        А ещё я записываю в журнал всё, что делал: кого и когда трогал, с датой и поимённым
        списком. Он открывается в боте кнопкой «История изменений».
      </p>

      <p class="cta">
        <a class="btn" href={BOT_URL} target="_blank" rel="noopener">Открыть Антибот_КитБот в MAX</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Держимся палитры сайта: свои цвета тут развалили бы общий вид. */
  .guide { max-width: 820px; }
