---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../data/site';
const posts = await getCollection('blog');
---
<BaseLayout title="Блог о розыгрышах в MAX | Приз_КитБот" description="Статьи о розыгрышах и конкурсах в MAX: инструкции, идеи и правила проведения.">
  <section><div class="container" style="max-width:740px;">
    <h1>Блог</h1>
    <ul class="post-list">
      {posts.map((p) => (
        <li><a href={withBase(`blog/${p.id}`)}>{p.data.title}</a><p class="muted">{p.data.description}</p></li>
      ))}
    </ul>
  </div></section>
</BaseLayout>
